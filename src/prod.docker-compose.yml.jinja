# You have check all TODO
networks:
  local:
services:
  kwkhtmltopdf:
    restart: always
    image: acsone/kwkhtmltopdf
    networks:
      - local
  odoo:
    restart: always
    # TODO
    image: registry.gitlab.akretion.com/akretion/{{ project_name }}:{{ odoo_version | replace(".", "-")}}_latest
    environment:
      # add and change your settings here

      SENTRY: "False"
      SENTRY_DSN:
      SENTRY_TRACES_SAMPLE_RATE: 0.00001

      ODOO_BASE_URL: https://{{ project_name }}.akretion.com

      LIMIT_TIME_CPU: 240
      LIMIT_TIME_REAL: 480
      LIMIT_TIME_REAL_CRON: 480

      # 1500Mb *1024² (Small projects)
      LIMIT_MEMORY_SOFT: 1572864000

      RUNNING_ENV: prod

      # sentry and bus_alt_connection don't require installation
      # bus_alt_connection is required for CI and prod
{% if branch_name == "20.0" %}
      SERVER_WIDE_MODULES: web
{% else %}
      SERVER_WIDE_MODULES: web,sentry,bus_alt_connection
{% endif %}

      # don't change after this line

      # ask infra team for the following
      PGSSLMODE: require
      DB_NAME: {{ project_name }}
      PGDATABASE: {{ project_name }}
      PGUSER:  {{ project_name }}
      DB_USER:  {{ project_name }}
      DB_HOST:
      PGHOST:
{% if branch_name == "20.0" %}
      # use pgbouncer
      DB_PORT: 6432
      PGPORT: 6432
{% endif %}

    volumes:
      - ~/data/${COMPOSE_PROJECT_NAME}/addons:/data/odoo/addons
      - ~/data/${COMPOSE_PROJECT_NAME}/filestore:/data/odoo/filestore
      - ~/data/${COMPOSE_PROJECT_NAME}/sessions:/data/odoo/sessions
    ports:
      - 8069:8069
      - 8072:8072
    networks:
      - local
    links:
      - kwkhtmltopdf
