# Environment of the kpiten services (kpiten.dc.yml). Tracked by git : no secret here
# (ODOO_PWD comes from the .env of the project, KPITEN_ODOO_PWD). Full list : bi/.env.example of KpiTen.
ODOO_HOST=odoo
ODOO_PORT=8069
ODOO_DB=db
ODOO_LOGIN=admin

# Direct read of Postgres to extract the parquets (same values as dev.docker-compose.yml)
PG_HOST=db
PG_PORT=5432
PG_USER=odoo
PG_PWD=odoo
PG_DB=db

# The parquets of the fronts, on the data volume of the project (./data/shared -> /data/odoo/shared)
DATA_PATH=/data/odoo/shared/kpiten
